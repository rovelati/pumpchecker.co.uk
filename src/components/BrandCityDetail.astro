---
import Layout from '../layouts/Layout.astro';
import AdSlot from './AdSlot.astro';

interface Props {
  brandName: string;
  brandSlug: string;
  cityName: string;
  citySlug: string;
  county?: string;
  lat: number;
  lng: number;
}

const { brandName, brandSlug, cityName, citySlug, county, lat, lng } = Astro.props;

const pageTitle = `${brandName} Fuel Prices in ${cityName} Today — Petrol & Diesel | PumpChecker`;
const pageDesc = `Check live ${brandName} petrol and diesel prices in ${cityName}${county ? `, ${county}` : ''}. Compare forecourt rates at ${brandName} filling stations near you with official CMA Open Fuel Data.`;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": pageTitle,
  "description": pageDesc,
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://pumpchecker.co.uk/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": `${brandName} Fuel Prices`,
        "item": `https://pumpchecker.co.uk/brand/${brandSlug}/`
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": cityName,
        "item": `https://pumpchecker.co.uk/brand/${brandSlug}/${citySlug}/`
      }
    ]
  }
};
---

<Layout title={pageTitle} description={pageDesc}>
  <section class="relative pt-8 pb-10 px-4 border-b border-zinc-800 bg-gradient-to-b from-zinc-900/60 to-zinc-950">
    <div class="max-w-6xl mx-auto">
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs text-zinc-400 mb-6 font-mono" aria-label="Breadcrumb">
        <a href="/" class="hover:text-sky-400 transition-colors">Home</a>
        <span>/</span>
        <a href={`/brand/${brandSlug}/`} class="hover:text-sky-400 transition-colors">{brandName}</a>
        <span>/</span>
        <span class="text-white font-semibold">{cityName}</span>
      </nav>

      <!-- Headings -->
      <div class="mb-6">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-sky-500/10 border border-sky-500/30 text-sky-400 text-xs font-semibold mb-2">
          <span class="w-2 h-2 rounded-full bg-sky-400 animate-pulse"></span>
          CMA Verified Retailer Feed
        </div>
        <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-400 to-cyan-300">{brandName}</span> Fuel Prices in {cityName}
        </h1>
        <p class="text-sm text-zinc-400 mt-1 max-w-2xl">
          Live Unleaded E10, Super Unleaded E5 and Diesel B7 rates at {brandName} forecourts serving {cityName}.
        </p>
      </div>

      <!-- Map Container -->
      <div class="relative w-full h-[300px] sm:h-[380px] rounded-2xl overflow-hidden border border-zinc-800 shadow-xl bg-zinc-900">
        <div id="brand-map" class="w-full h-full z-10"></div>
        <div id="brand-map-loading" class="absolute inset-0 z-20 flex items-center justify-center bg-zinc-950/80 backdrop-blur-sm text-sm text-zinc-400">
          <div class="flex items-center gap-2">
            <span class="w-4 h-4 border-2 border-sky-400 border-t-transparent rounded-full animate-spin"></span>
            Locating nearest {brandName} forecourts...
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Forecourts List -->
  <section class="max-w-6xl mx-auto px-4 py-10">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-bold text-white flex items-center gap-2">
        <span>{brandName} Stations around {cityName}</span>
        <span id="brand-stations-count" class="text-xs font-mono px-2 py-0.5 rounded-full bg-zinc-800 text-zinc-400">
          Searching...
        </span>
      </h2>
      <a href={`/petrol-stations/${citySlug}/`} class="text-xs text-sky-400 hover:text-sky-300 font-semibold">
        Compare all brands in {cityName} →
      </a>
    </div>

    <!-- Stations Grid Container -->
    <div id="brand-stations-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <div class="col-span-full py-12 text-center text-zinc-500 font-mono">
        Scanning {brandName} forecourt feeds...
      </div>
    </div>

    <AdSlot className="my-8" />
  </section>

  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <script is:inline define:vars={{ cityLat: lat, cityLng: lng, brandTarget: brandSlug.toLowerCase() }}>
    document.addEventListener('DOMContentLoaded', async () => {
      if (typeof L === 'undefined') return;

      const mapEl = document.getElementById('brand-map');
      const loaderEl = document.getElementById('brand-map-loading');
      if (!mapEl) return;

      const map = L.map('brand-map', { scrollWheelZoom: false }).setView([cityLat, cityLng], 11);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '© OpenStreetMap'
      }).addTo(map);

      const markers = L.layerGroup().addTo(map);

      function getDist(lat1, lon1, lat2, lon2) {
        const R = 6371;
        const dLat = (lat2 - lat1) * Math.PI / 180;
        const dLon = (lon2 - lon1) * Math.PI / 180;
        const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                  Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                  Math.sin(dLon/2) * Math.sin(dLon/2);
        return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
      }

      try {
        const res = await fetch('/cma_stations_index.json');
        const allStations = await res.json();

        const matching = allStations
          .filter(s => (s.b && s.b.toLowerCase().includes(brandTarget)) || (s.n && s.n.toLowerCase().includes(brandTarget)))
          .map(s => ({ ...s, dist: getDist(cityLat, cityLng, s.lt, s.lg) }))
          .sort((a, b) => a.dist - b.dist)
          .slice(0, 15);

        if (loaderEl) loaderEl.style.display = 'none';

        const countEl = document.getElementById('brand-stations-count');
        if (countEl) countEl.innerText = `${matching.length} forecourts found`;

        const grid = document.getElementById('brand-stations-grid');
        if (!grid) return;

        if (matching.length === 0) {
          grid.innerHTML = '<div class="col-span-full py-8 text-center text-zinc-500 font-mono">No forecourts found for this brand in the immediate vicinity.</div>';
          return;
        }

        grid.innerHTML = matching.map(s => `
          <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-4 flex flex-col justify-between">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-sky-400 font-mono">${s.b}</span>
              <h3 class="text-base font-bold text-white mb-1 mt-1">${s.n}</h3>
              <p class="text-xs text-zinc-400">${s.a ? s.a + ', ' : ''}${s.p || s.c}</p>
            </div>
            <div class="mt-4 pt-3 border-t border-zinc-800 space-y-1.5">
              <div class="flex items-center justify-between text-xs">
                <span class="text-zinc-400">Unleaded E10:</span>
                <strong class="text-white text-sm font-black font-mono">${s.e10 ? s.e10.toFixed(1) + 'p' : '—'}</strong>
              </div>
              <div class="flex items-center justify-between text-xs">
                <span class="text-zinc-400">Diesel B7:</span>
                <strong class="text-white text-sm font-black font-mono">${s.d ? s.d.toFixed(1) + 'p' : '—'}</strong>
              </div>
              <div class="flex items-center justify-between text-xs pt-1 border-t border-zinc-800/60">
                <span class="text-zinc-500">${s.dist ? s.dist.toFixed(1) + ' miles away' : ''}</span>
                ${s.sm ? '<span class="text-[10px] text-emerald-400 font-semibold">Supermarket Site</span>' : ''}
              </div>
            </div>
          </div>
        `).join('');

        matching.forEach(s => {
          const markerIcon = L.divIcon({
            className: 'pb-marker-standard',
            html: `<div style="padding: 4px 8px; border-radius: 9999px; font-size: 11px; white-space: nowrap;">${s.e10 ? s.e10.toFixed(1) + 'p' : 'Forecourt'}</div>`,
            iconSize: [64, 26],
            iconAnchor: [32, 13]
          });
          const marker = L.marker([s.lt, s.lg], { icon: markerIcon });
          marker.bindPopup(`<strong>${s.n}</strong><br/>${s.a} (${s.p})<br/>Unleaded: ${s.e10 ? s.e10.toFixed(1) + 'p' : '—'} | Diesel: ${s.d ? s.d.toFixed(1) + 'p' : '—'}`);
          markers.addLayer(marker);
        });

      } catch (err) {
        console.error('Brand forecourts error:', err);
      }
    });
  </script>
</Layout>
