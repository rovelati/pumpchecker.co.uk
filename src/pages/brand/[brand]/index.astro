---
import Layout from '@layouts/Layout.astro';
import AdSlot from '@components/AdSlot.astro';
import brands from '@data/uk_brands.json';
import cities from '@data/uk_cities.json';

export function getStaticPaths() {
  return brands.map((brand) => ({
    params: { brand: brand.slug },
    props: { brand },
  }));
}

const { brand } = Astro.props;

const topCities = cities.slice(0, 48);

const pageTitle = `${brand.name} Fuel Prices Today — Petrol & Diesel Near Me | PumpChecker`;
const pageDesc = `${brand.description} Search live forecourt prices across all UK locations using official CMA Open Fuel Data.`;
---

<Layout title={pageTitle} description={pageDesc}>
  <section class="relative pt-12 pb-16 px-4 border-b border-zinc-800 bg-gradient-to-b from-zinc-900/80 to-zinc-950">
    <div class="max-w-5xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-500/10 border border-sky-500/30 text-sky-400 text-xs font-semibold mb-6">
        <span class="w-2 h-2 rounded-full bg-sky-400 animate-pulse"></span>
        Official CMA Retailer Feed
      </div>

      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-4">
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-400 to-cyan-300">{brand.name}</span> Fuel Prices Today
      </h1>

      <p class="text-base sm:text-lg text-zinc-300 max-w-2xl mx-auto mb-8">
        {brand.description}
      </p>

      <div class="inline-flex items-center gap-4 text-xs font-mono text-zinc-400 bg-zinc-900 border border-zinc-800 px-4 py-2 rounded-xl">
        <span>Category: <strong class="text-white">{brand.type}</strong></span>
        <span>•</span>
        <span>Search Popularity: <strong class="text-sky-400">{brand.searchVolume}/mo</strong></span>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-12">
    <h2 class="text-xl font-bold text-white mb-6">
      Check {brand.name} Prices by City
    </h2>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
      {topCities.map((c) => (
        <a
          href={`/brand/${brand.slug}/${c.slug}/`}
          class="p-3.5 bg-zinc-900 border border-zinc-800 hover:border-sky-500/40 rounded-xl transition-all group block"
        >
          <div class="text-sm font-bold text-white group-hover:text-sky-400 transition-colors">
            {c.name}
          </div>
          <div class="text-xs text-zinc-500 mt-0.5">
            {brand.name} fuel rates
          </div>
        </a>
      ))}
    </div>

    <AdSlot className="my-10" />
  </section>
</Layout>
