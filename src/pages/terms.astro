---
import Layout from '../layouts/Layout.astro';

const title = "Terms of Use — PumpChecker.co.uk";
const description = "Terms and Conditions of use for the PumpChecker.co.uk UK fuel comparison service.";
---

<Layout title={title} description={description}>
  <section class="max-w-4xl mx-auto px-4 py-16 text-zinc-300 leading-relaxed text-sm">
    <h1 class="text-3xl font-black text-white mb-6">Terms of Use</h1>
    <p class="text-xs text-zinc-500 mb-8">Last updated: 26 October 2026</p>

    <div class="space-y-6">
      <section>
        <h2 class="text-lg font-bold text-white mb-2">1. Acceptance</h2>
        <p>
          By using PumpChecker.co.uk, you agree to these terms. If you do not agree, please do not use the website.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-bold text-white mb-2">2. Accuracy of Fuel Prices</h2>
        <p>
          PumpChecker.co.uk aggregates public pricing information under the UK Competition and Markets Authority (CMA) Open Fuel Data scheme. Prices are provided for general consumer guidance and are subject to real-time changes by individual forecourts. The physical price displayed on the forecourt totem pole is legally binding.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-bold text-white mb-2">3. Intellectual Property</h2>
        <p>
          The website design, layout, code and compilations are the copyright of PumpChecker.co.uk. Brand trademarks (e.g. Tesco, Asda, Shell, BP, Esso) belong to their respective holders and are used purely for nominative comparison purposes.
        </p>
      </section>
    </div>
  </section>
</Layout>
