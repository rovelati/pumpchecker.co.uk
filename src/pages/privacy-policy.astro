---
import Layout from '../layouts/Layout.astro';

const title = "Privacy Policy — PumpChecker.co.uk";
const description = "Privacy Policy for PumpChecker.co.uk in compliance with the UK General Data Protection Regulation (UK GDPR) and Data Protection Act 2018.";
---

<Layout title={title} description={description}>
  <section class="max-w-4xl mx-auto px-4 py-16 text-zinc-300 leading-relaxed text-sm">
    <h1 class="text-3xl font-black text-white mb-6">Privacy Policy</h1>
    <p class="text-xs text-zinc-500 mb-8">Last updated: 26 October 2026</p>

    <div class="space-y-6">
      <section>
        <h2 class="text-lg font-bold text-white mb-2">1. Overview</h2>
        <p>
          PumpChecker.co.uk ("we", "our", or "us") is dedicated to protecting your privacy in full compliance with the UK General Data Protection Regulation (UK GDPR) and the Data Protection Act 2018. This policy describes how we handle information when you access our website.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-bold text-white mb-2">2. Data We Process</h2>
        <p>
          We do not require user account registration. When you choose to use the "Locate Me" or "GPS" feature, your coordinates are processed strictly client-side within your browser to calculate the distance to nearby forecourts and are never stored on our servers.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-bold text-white mb-2">3. Advertising and Cookies</h2>
        <p>
          We use Google AdSense to serve advertisements. Google and its certified partners use cookies to serve ads based on prior visits. You can manage or revoke your consent at any time using our Cookie Preferences tool.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-bold text-white mb-2">4. Open Data Notice</h2>
        <p>
          Forecourt fuel pricing information is sourced under the UK Competition and Markets Authority (CMA) Road Fuel Price Transparency scheme. While we update prices daily, totems at physical forecourts take precedence.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-bold text-white mb-2">5. Contact</h2>
        <p>
          For privacy or data enquiries, contact us at: <span class="font-mono text-sky-400">privacy@pumpchecker.co.uk</span>.
        </p>
      </section>
    </div>
  </section>
</Layout>
